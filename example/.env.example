LATCHWAY_BASE_URL=https://gateway.example.com
LATCHWAY_APPLICATION_ID=app_01J00000000000000000000000
LATCHWAY_PACKAGE_OR_BUNDLE_IDENTIFIER=dev.latchway
LATCHWAY_ENVIRONMENT=development
LATCHWAY_FEATURE=assistant
LATCHWAY_ERROR_MAPPING_FEATURE=conformance_missing_feature
LATCHWAY_MODEL=assistant-default
LATCHWAY_GOOGLE_CLOUD_PROJECT_NUMBER=123456789012
LATCHWAY_CONFORMANCE_AUTORUN=false
# Required by an iOS build. Use the fully resolved private group that is first
# in the root target's signed keychain-access-groups entitlement. List every
# explicit extension-shared group in the comma-separated legacy value.
# LATCHWAY_IOS_ROOT_KEYCHAIN_ACCESS_GROUP=<App ID Prefix>.dev.latchway
# LATCHWAY_IOS_LEGACY_SHARED_KEYCHAIN_ACCESS_GROUPS=<App ID Prefix>.dev.latchway.keychain

# The physical-device workflow builds a separate Release candidate with the
# following protected, non-secret release pins. Do not replace these comments
# with dummy values in a distributable build: the collector requires the exact
# candidate/core/native commits, evidence hash, gateway digest/configuration,
# distribution, signing identity, and platform trust policy.
# The error-mapping feature must be protected and guaranteed absent.
# LATCHWAY_SOURCE_COMMIT=<40 lowercase hex>
# LATCHWAY_CORE_COMMIT=<40 lowercase hex>
# LATCHWAY_CONTRACT_BUNDLE_SHA256=<64 lowercase hex>
# LATCHWAY_GATEWAY_IMAGE_DIGEST=sha256:<64 lowercase hex>
# LATCHWAY_GATEWAY_CONFIGURATION_SHA256=<64 lowercase hex>
# LATCHWAY_GATEWAY_ORIGIN=https://gateway.example.com
# LATCHWAY_GATEWAY_DEPLOYMENT_KEY_ID=<deployment signing key ID>
# LATCHWAY_GATEWAY_DEPLOYMENT_STATEMENT_SHA256=<64 lowercase hex>
# LATCHWAY_GATEWAY_DEPLOYMENT_PUBLIC_KEY_SHA256=<SHA-256 of P-256 SPKI DER>
# LATCHWAY_NATIVE_EVIDENCE_SHA256=<64 lowercase hex>
# LATCHWAY_NATIVE_SDK_VERSION=<semver>
# LATCHWAY_DISTRIBUTION=<ad_hoc|testflight|app_store|play_internal|play_closed|play_open|play_production>
# LATCHWAY_SIGNING_CERTIFICATE_SHA256=<64 lowercase hex>
# iOS only:
# The signed main.jsbundle SHA-256 is computed after the build, bound by the
# candidate manifest/collector lease, and supplied through the iOS native
# launch environment. It cannot be embedded inside the bytes it hashes.
# LATCHWAY_IOS_TEAM_ID=<10-character team ID>
# LATCHWAY_IOS_APP_ID_PREFIX=<10-character App ID Prefix; it may differ from Team ID>
# LATCHWAY_IOS_APPINTENTS_BUNDLE_ID=dev.latchway.AppIntents
# The root-private group is derived as <App ID Prefix>.dev.latchway. The signed
# root target must list [root-private, shared] in that order; the App Intents
# target must list only shared. Each profile must authorize its signed groups.
# Root signing/profile also require App Attest opt-in=[CDhash]; the extension
# must carry neither App Attest entitlement key.
# LATCHWAY_IOS_SHARED_KEYCHAIN_ACCESS_GROUP=<App ID Prefix>.dev.latchway.keychain
# LATCHWAY_IOS_PROVISIONING_PROFILE_UUID=<root application profile UUID>
# LATCHWAY_IOS_APPINTENTS_PROVISIONING_PROFILE_UUID=<distinct extension profile UUID>
# LATCHWAY_APP_ATTEST_ENVIRONMENT=production
# Android only:
# LATCHWAY_PLAY_TRACK=<internal|closed|open|production>
# LATCHWAY_REQUIRE_LICENSED=true
